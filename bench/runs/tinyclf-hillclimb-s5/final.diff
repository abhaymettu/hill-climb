+def _forward(P, Z):
+    H = np.tanh(Z @ P[0] + P[1])
+    return H, H @ P[2] + P[3]
+
+
+def fit(X, y, hidden=128, epochs=1500, lr=0.05, wd=1e-2, seed=0):
+    rng = np.random.default_rng(seed)
+    st = (X.mean(0), X.std(0) + 1e-8)
+    Z = (X - st[0]) / st[1]
+    P = [rng.normal(0, 0.5, (Z.shape[1], hidden)), np.zeros(hidden),
+         rng.normal(0, 0.5, hidden) / np.sqrt(hidden), 0.0]
+    M = [np.zeros_like(p) for p in P]
+    V = [np.zeros_like(p) for p in P]
+    n = len(y)
+    for t in range(1, epochs + 1):
+        H, o = _forward(P, Z)
+        d = (1 / (1 + np.exp(-o)) - y) / n
+        dH = np.outer(d, P[2]) * (1 - H ** 2)
+        G = [Z.T @ dH + wd * P[0], dH.sum(0), H.T @ d + wd * P[2], d.sum()]
+        for i in range(4):
+            M[i] = 0.9 * M[i] + 0.1 * G[i]
+            V[i] = 0.999 * V[i] + 0.001 * G[i] ** 2
+            P[i] = P[i] - lr * (M[i] / (1 - 0.9 ** t)) / (np.sqrt(V[i] / (1 - 0.999 ** t)) + 1e-8)
+    return st, P
 
 
