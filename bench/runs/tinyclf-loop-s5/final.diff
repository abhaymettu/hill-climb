+def _feats(X, mu, sd):
+    Z = (X - mu) / sd
+    return np.hstack([Z, np.ones((len(Z), 1)), Z[:, :12] ** 2, (Z[:, 0] * Z[:, 1])[:, None]])
+
+
+def fit(X, y, l2=10.0, iters=25):
+    mu, sd = X.mean(0), X.std(0)
+    F = _feats(X, mu, sd)
+    reg = l2 * np.eye(F.shape[1])
+    reg[16, 16] = 0  # leave the bias unpenalised
+    w = np.zeros(F.shape[1])
+    for _ in range(iters):  # Newton / IRLS for L2-regularised logistic regression
+        p = 1 / (1 + np.exp(-np.clip(F @ w, -30, 30)))
+        g = F.T @ (p - y) + reg @ w
+        H = (F * (p * (1 - p))[:, None]).T @ F + reg
+        w -= np.linalg.solve(H, g)
+    return mu, sd, w
 
 
