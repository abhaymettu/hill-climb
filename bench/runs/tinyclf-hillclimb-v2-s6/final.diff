+def _forward(P, Z):
+    return np.tanh(Z @ P[0] + P[1]) @ P[2] + P[3][0]
+
+
+def _fit_one(X, y, hidden, epochs, lr, l2, seed):
+    Z = X
+    r = np.random.RandomState(seed)
+    P = [r.randn(X.shape[1], hidden) * 0.3, np.zeros(hidden), r.randn(hidden) * 0.3, np.zeros(1)]
+    M = [np.zeros_like(p) for p in P]
+    V = [np.zeros_like(p) for p in P]
+    for t in range(1, epochs + 1):
+        H = np.tanh(Z @ P[0] + P[1])
+        d = (1 / (1 + np.exp(-(H @ P[2] + P[3][0]))) - y) / len(y)
+        dH = np.outer(d, P[2]) * (1 - H**2)
+        G = [Z.T @ dH + l2 * P[0], dH.sum(0), H.T @ d + l2 * P[2], np.array([d.sum()])]
+        for k in range(4):  # Adam
+            M[k] = 0.9 * M[k] + 0.1 * G[k]
+            V[k] = 0.999 * V[k] + 0.001 * G[k] ** 2
+            P[k] -= lr * (M[k] / (1 - 0.9**t)) / (np.sqrt(V[k] / (1 - 0.999**t)) + 1e-8)
+    return P
+
