+def features(X):
+    return np.column_stack([
+        X[:, 0] * X[:, 1],
+        np.sin(2 * X[:, 2]),
+        X[:, 3] ** 2,
+        X[:, 4] ** 2,
+        X[:, 5],
+        np.abs(X[:, 6]),
+        X[:, 7],
+    ])
+
+
+def _design(F, mu, sd):
+    return np.hstack([(F - mu) / sd, np.ones((len(F), 1))])
+
+
+def fit(X, y, l2=1e-3, iters=50):
+    F = features(X)
+    mu, sd = F.mean(0), F.std(0) + 1e-9
+    Z = _design(F, mu, sd)
+    w = np.zeros(Z.shape[1])
+    reg = l2 * np.eye(len(w))
+    reg[-1, -1] = 0
+    for _ in range(iters):  # Newton's method on L2-regularised log loss
+        p = 1 / (1 + np.exp(-Z @ w))
+        g = Z.T @ (p - y) / len(y) + reg @ w
+        H = Z.T @ (Z * (p * (1 - p))[:, None]) / len(y) + reg
+        w -= np.linalg.solve(H, g)
+        if np.abs(g).max() < 1e-10:
+            break
+    return mu, sd, w
 
 
