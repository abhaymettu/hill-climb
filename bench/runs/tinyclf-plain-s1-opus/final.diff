+def fit(X, y, lam=1e-3, iters=50):
+    mu, sd = X.mean(0), X.std(0) + 1e-9
+    A = _features((X - mu) / sd)
+    y = y.astype(float)
+    w = np.zeros(A.shape[1])
+    for _ in range(iters):  # Newton's method on L2-regularized log loss
+        p = 1 / (1 + np.exp(-A @ w))
+        H = A.T @ (A * (p * (1 - p))[:, None]) / len(y) + lam * np.eye(len(w))
+        g = A.T @ (p - y) / len(y) + lam * w
+        w -= np.linalg.solve(H, g)
+    return mu, sd, w
 
 
