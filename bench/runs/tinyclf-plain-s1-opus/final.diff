 """A binary classifier. eval.py calls fit(X, y) on the training split and predict(model, X) on new rows.
 
 X is a float array of shape (n, 16), y is 0/1 of shape (n,). numpy is the only dependency available.
+
+Logistic regression on a small set of engineered features, chosen by 5-fold CV on the training split:
+the label depends on x0*x1, x3^2, x4^2, a periodic effect of x2, |x6|, and linear x5/x7. Columns 8-15
+showed no signal and are dropped.
 """
 import numpy as np
 
+LIN = [0, 1, 2, 3, 4, 5, 7]
+
+
+def _features(Z):
+    return np.hstack([
+        Z[:, LIN],
+        Z[:, [0]] * Z[:, [1]],
+        Z[:, [3]] ** 2,
+        Z[:, [4]] ** 2,
+        np.sin(2 * Z[:, [2]]),
+        np.cos(2 * Z[:, [2]]),
+        np.abs(Z[:, [6]]),
+        np.ones((len(Z), 1)),
+    ])
+
 
-def fit(X, y, lr=0.1, epochs=200):
