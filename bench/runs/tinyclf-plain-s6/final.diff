+def fit(X, y, hidden=64, epochs=150, lr=0.01, wd=7e-3, seed=0, nets=5):
+    mu, sd = X.mean(0), X.std(0) + 1e-8
+    Z = (X - mu) / sd
+    y = y.astype(float)[:, None]
+    n = len(Z)
+    Ps = []
+    for k in range(nets):
+        r = np.random.RandomState(seed + k)
+        P = {"W1": r.randn(Z.shape[1], hidden) / np.sqrt(Z.shape[1]), "b1": np.zeros(hidden),
+             "W2": r.randn(hidden, hidden) / np.sqrt(hidden), "b2": np.zeros(hidden),
+             "W3": r.randn(hidden, 1) / np.sqrt(hidden), "b3": np.zeros(1)}
+        m = {q: np.zeros_like(v) for q, v in P.items()}
+        s = {q: np.zeros_like(v) for q, v in P.items()}
+        t = 0
+        for ep in range(epochs):
+            idx = r.permutation(n)
