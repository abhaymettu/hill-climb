+                b = idx[i:i + 128]
+                xb = Z[b]
+                h = np.tanh(xb @ P["W1"] + P["b1"])
+                h2 = np.tanh(h @ P["W2"] + P["b2"])
+                p = 1 / (1 + np.exp(-(h2 @ P["W3"] + P["b3"])))
