+def features(X):
+    return np.column_stack([
+        X[:, 0] * X[:, 1],
+        X[:, 3] ** 2,
+        X[:, 4] ** 2,
+        X[:, 5],
+        X[:, 7],
+        np.sin(2 * X[:, 2]),
+        np.abs(X[:, 6]),
+        X[:, 7] * X[:, 8],
+    ])
+
+
+def _design(model, X):
+    mu, sd, _ = model
+    F = (features(X) - mu) / sd
+    return np.hstack([F, np.ones((len(F), 1))])
+
+
+def fit(X, y, lam=0.1, iters=30):
+    F = features(X)
+    mu, sd = F.mean(0), F.std(0) + 1e-9
+    Fb = _design((mu, sd, None), X)
+    R = lam * np.eye(Fb.shape[1])
+    R[-1, -1] = 0
+    w = np.zeros(Fb.shape[1])
+    for _ in range(iters):
+        p = 1 / (1 + np.exp(-Fb @ w))
+        H = Fb.T @ (Fb * (p * (1 - p))[:, None]) + R
+        w -= np.linalg.solve(H, Fb.T @ (p - y) + R @ w)
+    return mu, sd, w
 
 
