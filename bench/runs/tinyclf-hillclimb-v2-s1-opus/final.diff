+def _features(Z):
+    # Linear, squared and pairwise-product terms of the standardized inputs.
+    iu = np.triu_indices(Z.shape[1], 1)
+    pairs = (Z[:, :, None] * Z[:, None, :])[:, iu[0], iu[1]]
+    return np.hstack([Z, Z ** 2, pairs])
+
+
+def _design(model, X):
+    mu, sd, fm, fs, _ = model
+    A = (_features((X - mu) / sd) - fm) / fs
+    return np.hstack([A, np.ones((len(A), 1))])
+
+
+def fit(X, y, lam=0.02, iters=3000):
+    mu, sd = X.mean(0), X.std(0) + 1e-9
+    F = _features((X - mu) / sd)
+    fm, fs = F.mean(0), F.std(0) + 1e-9
+    A = _design((mu, sd, fm, fs, None), X)
+    # L1-regularized logistic regression by FISTA; the penalty keeps only the few terms that carry signal.
+    L = 0.25 * np.linalg.norm(A, 2) ** 2 / len(y)
+    w = np.zeros(A.shape[1])
+    z, t = w.copy(), 1.0
+    for _ in range(iters):
+        p = 1 / (1 + np.exp(-A @ z))
+        wn = z - A.T @ (p - y) / len(y) / L
+        wn[:-1] = np.sign(wn[:-1]) * np.maximum(np.abs(wn[:-1]) - lam / L, 0)
+        tn = (1 + np.sqrt(1 + 4 * t * t)) / 2
+        z = wn + (t - 1) / tn * (wn - w)
+        w, t = wn, tn
+    return mu, sd, fm, fs, w
 
 
