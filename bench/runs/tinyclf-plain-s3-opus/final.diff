+def _features(Z):
+    return np.hstack([
+        Z[:, :12],
+        Z[:, [0]] * Z[:, [1]],
+        Z[:, [3]] ** 2,
+        Z[:, [4]] ** 2,
+        np.sin(2 * Z[:, [2]]),
+        np.cos(2 * Z[:, [2]]),
+    ])
+
+
+def _design(model, X):
+    F = _features((X - model["mu"]) / model["sd"])
+    F = (F - model["fm"]) / model["fs"]
+    return np.hstack([F, np.ones((len(F), 1))])
+
+
+def fit(X, y, lam=1.0, iters=30):
+    model = {"mu": X.mean(0), "sd": X.std(0) + 1e-9}
+    F = _features((X - model["mu"]) / model["sd"])
+    model["fm"], model["fs"] = F.mean(0), F.std(0) + 1e-9
+    Fb = _design(model, X)
+    R = lam * np.eye(Fb.shape[1])
+    R[-1, -1] = 0  # do not penalise the bias
+    w = np.zeros(Fb.shape[1])
+    for _ in range(iters):
+        p = 1 / (1 + np.exp(-Fb @ w))
+        g = Fb.T @ (p - y) + R @ w
+        H = (Fb * (p * (1 - p))[:, None]).T @ Fb + R
+        w -= np.linalg.solve(H, g)
+    model["w"] = w
+    return model
 
 
