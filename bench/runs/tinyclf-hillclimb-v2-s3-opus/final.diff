+def _quad(X):
+    i, j = np.triu_indices(X.shape[1])
+    return np.hstack([X, X[:, i] * X[:, j]])
+
+
+def _hinge(X):
+    # Pairwise products for interactions, plus a per-feature hinge basis for non-monotone main effects.
+    # Hinges on the squares too, for radial effects that flatten or steepen away from zero.
+    return np.hstack([_quad(X)] + [np.maximum(X - k, 0) for k in KNOTS] + [np.maximum(X**2 - k, 0) for k in SQ_KNOTS])
+
+
+def _l1_logreg(F, y, lam, lr=0.5, epochs=3000):
+    mu, sd = F.mean(0), F.std(0) + 1e-9
+    Z = np.hstack([(F - mu) / sd, np.ones((len(F), 1))])
+    w = np.zeros(Z.shape[1])
     for _ in range(epochs):
