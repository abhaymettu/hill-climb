+def fit(X, y, lam_select=2e-2, lam=1e-2, threshold=0.1):
+    # Stage 1: sparse quadratic model to find which raw features carry signal.
+    _, _, w = _l1_logreg(_quad(X), y, lam_select)
+    d = X.shape[1]
