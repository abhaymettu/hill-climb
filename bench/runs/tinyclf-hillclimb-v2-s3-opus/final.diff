+        p = 1 / (1 + np.exp(-Z @ w))
+        w -= lr * Z.T @ (p - y) / len(y)
+        # L1 proximal step: most terms are noise, so shrink them to zero (bias unpenalized).
+        w[:-1] = np.sign(w[:-1]) * np.maximum(np.abs(w[:-1]) - lr * lam, 0)
+    return mu, sd, w
+
