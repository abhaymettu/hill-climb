+        importance[b] += abs(c)
+    keep = np.where(importance > threshold)[0]
+    # Stage 2: richer basis on the selected features only, with a lighter penalty.
+    return keep, _l1_logreg(_hinge(X[:, keep]), y, lam)
 
 
