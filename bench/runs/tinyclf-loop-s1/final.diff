+def _fwd(P, X):
+    mu, sd, W1, b1, W2, b2 = P
+    H = np.tanh(((X - mu) / sd) @ W1 + b1)
+    return H, H @ W2 + b2
+
+
+def _fit1(X, y, hidden=64, epochs=600, lr=0.01, wd=6e-3, seed=0):
+    rng = np.random.default_rng(seed)
+    mu, sd = X.mean(0), X.std(0) + 1e-8
+    Z = (X - mu) / sd
+    W1 = rng.normal(0, 1 / np.sqrt(Z.shape[1]), (Z.shape[1], hidden)); b1 = np.zeros(hidden)
+    W2 = rng.normal(0, 1 / np.sqrt(hidden), hidden); b2 = 0.0
+    prm = [W1, b1, W2, b2]
+    m = [np.zeros_like(p) for p in prm]; v = [np.zeros_like(p) for p in prm]
+    n = len(y); bs = 128; t = 0
+    for ep in range(epochs):
+        idx = rng.permutation(n)
+        for s in range(0, n, bs):
+            j = idx[s:s + bs]
+            H = np.tanh(Z[j] @ W1 + b1)
+            p = 1 / (1 + np.exp(-(H @ W2 + b2)))
+            d = (p - y[j]) / len(j)
+            dH = np.outer(d, W2) * (1 - H ** 2)
+            g = [Z[j].T @ dH + wd * W1, dH.sum(0), H.T @ d + wd * W2, d.sum()]
+            t += 1
+            for i in range(4):
+                m[i] = 0.9 * m[i] + 0.1 * g[i]; v[i] = 0.999 * v[i] + 0.001 * g[i] ** 2
+                prm[i] = prm[i] - lr * (m[i] / (1 - 0.9 ** t)) / (np.sqrt(v[i] / (1 - 0.999 ** t)) + 1e-8)
+            W1, b1, W2, b2 = prm
+    return (mu, sd, W1, b1, W2, b2)
+
+
+def fit(X, y, n_models=8):
+    return [_fit1(X, y, seed=s) for s in range(n_models)]
 
 
