+def _features(X):
+    i, j = np.triu_indices(X.shape[1])
+    return np.hstack([X, X[:, i] * X[:, j]])
+
+
+def fit(X, y, lam=0.02, iters=2000):
+    Z = _features(X)
+    mu, sd = Z.mean(0), Z.std(0) + 1e-9
+    Z = (Z - mu) / sd
+    n = len(y)
+    step = 1 / (0.25 * np.linalg.norm(Z, 2) ** 2 / n)
+    w = np.zeros(Z.shape[1])
+    b = 0.0
+    v, vb, t = w.copy(), b, 1.0
+    for _ in range(iters):
+        p = 1 / (1 + np.exp(-(Z @ v + vb)))
+        w_new = v - step * Z.T @ (p - y) / n
+        w_new = np.sign(w_new) * np.maximum(np.abs(w_new) - step * lam, 0)
+        b_new = vb - step * (p - y).mean()
+        t_new = (1 + np.sqrt(1 + 4 * t * t)) / 2
+        v = w_new + (t - 1) / t_new * (w_new - w)
+        vb = b_new + (t - 1) / t_new * (b_new - b)
+        w, b, t = w_new, b_new, t_new
+    return w, b, mu, sd
 
 
