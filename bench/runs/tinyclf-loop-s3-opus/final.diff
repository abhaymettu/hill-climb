+def _features(X):
+    cols = [
+        X[:, 5],
+        X[:, 7],
+        X[:, 0] * X[:, 1],
+        X[:, 3] ** 2,
+        X[:, 4] ** 2,
+        np.sin(2 * X[:, 2]),
+        np.abs(X[:, 6]),
+    ]
+    return np.column_stack(cols + [np.ones(len(X))])
+
+
+def fit(X, y, lam=1.0, iters=30):
+    F = _features(X)
+    w = np.zeros(F.shape[1])
+    R = lam * np.eye(len(w))
+    R[-1, -1] = 0  # do not penalise the bias
+    for _ in range(iters):  # Newton's method on L2-regularised log loss
+        p = 1 / (1 + np.exp(-F @ w))
+        H = (F * (p * (1 - p))[:, None]).T @ F + R
+        w -= np.linalg.solve(H, F.T @ (p - y) + R @ w)
     return w
 
 
