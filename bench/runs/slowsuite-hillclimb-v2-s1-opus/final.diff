+    # Shared by tests that only read it; a test that mutates must use fresh_big_catalog.
     return build_big_catalog()
 
 
+@pytest.fixture
+def fresh_big_catalog(big_catalog):
+    # The shared catalog, with every stock level put back afterwards so later tests see it untouched.
+    items = big_catalog.items
+    snapshot = {sku: it["qty"] for sku, it in items.items()}
+    yield big_catalog
+    for sku, qty in snapshot.items():
+        items[sku]["qty"] = qty
+
