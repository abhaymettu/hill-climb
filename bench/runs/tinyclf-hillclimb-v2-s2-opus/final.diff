+FREQS = (1, 2)
+
+
+def _features(X, mu, sd):
+    """Intercept, linear, all pairwise products, and a per-feature sin/cos basis on standardised X."""
+    Z = (X - mu) / sd
+    i, j = np.triu_indices(Z.shape[1])
+    cols = [np.ones((len(Z), 1)), Z, Z[:, i] * Z[:, j]]
+    for f in FREQS:
+        cols += [np.sin(f * Z), np.cos(f * Z)]
+    return np.hstack(cols)
+
+
+def fit(X, y, l1=0.02, iters=3000):
+    """L1-regularised logistic regression over a wide feature dictionary, fit by FISTA.
+
+    Only a handful of the ~250 candidate terms carry signal; the L1 penalty (chosen by 5-fold CV on the
+    training split) zeroes the rest. Every column is scaled to unit variance so the penalty treats them alike.
+    """
+    mu, sd = X.mean(0), X.std(0) + 1e-12
+    Phi = _features(X, mu, sd)
+    scale = Phi.std(0)
+    scale[scale < 1e-9] = 1
+    Phi = Phi / scale
+    n = len(y)
+    step = 4 * n / np.linalg.norm(Phi, 2) ** 2
+    w = np.zeros(Phi.shape[1])
+    z, t = w.copy(), 1.0
+    for _ in range(iters):
+        p = 1 / (1 + np.exp(-Phi @ z))
+        w_new = z - step * Phi.T @ (p - y) / n
+        w_new[1:] = np.sign(w_new[1:]) * np.maximum(np.abs(w_new[1:]) - step * l1, 0)
+        t_new = (1 + np.sqrt(1 + 4 * t * t)) / 2
+        z = w_new + (t - 1) / t_new * (w_new - w)
+        w, t = w_new, t_new
+    return mu, sd, w / scale
 
 
