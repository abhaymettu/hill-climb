+def _sqdist(P, Q):
+    return (P ** 2).sum(1)[:, None] + (Q ** 2).sum(1)[None] - 2 * P @ Q.T
+
+
+def fit(X, y, gamma=0.3, lam=0.1):
+    """Kernel ridge regression with an RBF kernel on standardized features."""
+    mu, sd = X.mean(0), X.std(0) + 1e-9
+    A = (X - mu) / sd
+    K = np.exp(-gamma * _sqdist(A, A) / A.shape[1])
+    alpha = np.linalg.solve(K + lam * np.eye(len(A)), 2.0 * y - 1)
+    return mu, sd, A, alpha, gamma
 
 
