+def _features(X):
+    return np.column_stack([
+        X[:, 0] * X[:, 1],
+        np.sin(1.9 * X[:, 2]),
+        X[:, 3] ** 2,
+        X[:, 4] ** 2,
+        X[:, 5],
+        np.abs(X[:, 6]),
+        X[:, 7],
+        np.ones(len(X)),
+    ])
+
+
+def fit(X, y, lam=1.0, iters=50):
+    F = _features(X)
+    w = np.zeros(F.shape[1])
+    reg = lam * np.eye(len(w))
+    reg[-1, -1] = 0.0
+    for _ in range(iters):  # Newton's method on L2-penalized log loss
+        p = 1 / (1 + np.exp(-F @ w))
+        g = F.T @ (p - y) + reg @ w
+        H = F.T @ (F * (p * (1 - p))[:, None]) + reg
+        step = np.linalg.solve(H, g)
+        w -= step
+        if np.abs(step).max() < 1e-10:
+            break
     return w
 
 
