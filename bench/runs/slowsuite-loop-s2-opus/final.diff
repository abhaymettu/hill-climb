+    add = c.add
+    prices = BIG_PRICES
+    even, odd = ("even",), ("odd",)
+    for i in range(BIG_N):
+        add(f"SKU{i:06d}", prices[i % 997], i % 13, tags=odd if i & 1 else even)
     return c
 
 
-@pytest.fixture
-def big_catalog():
+@pytest.fixture(scope="session")
+def _big_catalog_shared():
     return build_big_catalog()
 
 
+@pytest.fixture
+def big_catalog(_big_catalog_shared):
+    # Built once per session; stock levels are restored after each test so tests stay isolated.
+    c = _big_catalog_shared
+    skus = list(c.items)
+    qtys = [it["qty"] for it in c.items.values()]
+    yield c
+    if list(c.items) != skus:
+        c.items = build_big_catalog().items
+        return
+    for it, q in zip(c.items.values(), qtys):
